{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host Debug",
      "description": "Native Linux build for the current machine",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "raspi-armhf",
      "displayName": "Raspberry Pi ARMHF",
      "description": "Cross-compile for 32-bit Raspberry Pi Linux using arm-linux-gnueabihf-gcc/g++",
      "binaryDir": "${sourceDir}/build/raspi-armhf",
      "toolchainFile": "${sourceDir}/cmake/toolchains/raspi-armhf.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "raspi-aarch64",
      "displayName": "Raspberry Pi AArch64",
      "description": "Cross-compile for 64-bit Raspberry Pi OS (Pi 5 / Pi 4) using aarch64-linux-gnu-gcc/g++",
      "binaryDir": "${sourceDir}/build/raspi-aarch64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/raspi-aarch64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "raspi-armhf",
      "configurePreset": "raspi-armhf"
    },
    {
      "name": "raspi-aarch64",
      "configurePreset": "raspi-aarch64"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "raspi-armhf",
      "configurePreset": "raspi-armhf",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "raspi-aarch64",
      "configurePreset": "raspi-aarch64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}